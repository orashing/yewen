APP_ENV=local
# Safe-by-default template. For a local throwaway demo only, explicitly flip these to true.
ALLOW_MOCK_FALLBACK=false
ALLOW_DEMO_AUTH=false

OPENAI_API_KEY=
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_MODEL_SOL=gpt-5.6-sol
OPENAI_PREMIUM_TASKS=
OPENAI_MONTHLY_BUDGET_USD=5
OPENAI_MAX_RETRIES=2
# Optional persistent path; mount this directory if the API runs in a container/cloud host.
OPENAI_USAGE_DB=./data/usage.sqlite3

SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173
